# Adresse de l'API. À laisser vide en production quand l'API sert aussi le site (adresse relative /api).
# En développement : http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# Valeurs de secours uniquement : le numéro WhatsApp et les messages se règlent dans
